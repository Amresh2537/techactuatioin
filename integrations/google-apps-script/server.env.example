# Optional: override the original Apps Script deployment URL after redeploying.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional: must match Script Property WEBSITE_SECRET if that property is set.
# Keep this server-only; do not use a NEXT_PUBLIC_ prefix.
GOOGLE_APPS_SCRIPT_SECRET=
